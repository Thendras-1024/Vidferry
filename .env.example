# YouTube 原始视频下载目录；可填相对路径或绝对路径。
YOUTUBE_DOWNLOAD_DIR=./videos/youtube
# 处理后视频输出目录；字幕烧录、剪辑结果会写到这里。
YOUTUBE_PROCESSED_DIR=./videos/processed

# 后端监听地址；本机使用建议保持 127.0.0.1，需要局域网访问时才改成 0.0.0.0。
VIDFERRY_HOST=127.0.0.1
# 后端监听端口；前端 API 请求需要和这个端口一致。
VIDFERRY_PORT=5409
# 允许访问后端的前端地址列表；多个地址用英文逗号分隔。
VIDFERRY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175

# 是否启用 SQLite WAL 模式；1 表示启用，可提升并发读写稳定性。
SQLITE_ENABLE_WAL=1
# SQLite 忙等待超时时间，单位毫秒；数据库被占用时最多等待这么久。
SQLITE_BUSY_TIMEOUT_MS=5000
# 工作流同时下载 YouTube 视频的最大任务数。
WORKFLOW_MAX_DOWNLOAD_JOBS=2
# 工作流同时处理视频的最大任务数；建议保持 1，避免 FFmpeg/字幕处理抢占资源。
WORKFLOW_MAX_PROCESSING_JOBS=1
# 工作流同时进行 AI 分析的最大任务数。
WORKFLOW_MAX_ANALYSIS_JOBS=2

# yt-dlp 使用的 JavaScript 运行时；留空时自动优先检测 deno，再检测 node。
# YTDLP_JS_RUNTIME=node
# JavaScript 运行时可执行文件路径；当自动检测失败或需要指定版本时填写。
# YTDLP_JS_RUNTIME_PATH=C:/nvm4w/nodejs/node.exe
# 是否允许 yt-dlp 拉取外部 challenge solver 组件；YouTube 需要额外解密组件时再开启。
# YTDLP_REMOTE_COMPONENTS=ejs:github

# OpenAI-compatible LLM 接口地址；用于内容分析、剪辑方案、发布文案等 AI 功能。
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM API Key；可配置为平台密钥，实际项目中不要提交真实密钥。
# LLM_API_KEY=sk-your-dashscope-key
# LLM 模型名称；需要和所选接口服务支持的模型一致。
# LLM_MODEL=qwen-plus
# LLM 请求超时时间，单位秒。
# LLM_TIMEOUT=90
# 单次送入 LLM 的字幕最大字符数；过大可能增加 token 消耗和响应时间。
# LLM_MAX_TRANSCRIPT_CHARS=28000

# 是否启用 Vidferry Agent 能力；true 开启，false 关闭。
AGENT_ENABLED=true
# Agent 文本对话/推理模型；留空时使用项目默认 LLM 模型配置。
AGENT_CHAT_MODEL=
# Agent 视觉模型；开启发布前视觉检查时必须配置可用模型。
AGENT_VISION_MODEL=
# 是否要求发布前执行 Agent 风险检查；true 表示发布前会先检查内容风险。
AGENT_REQUIRE_PREPUBLISH_CHECK=true
# 风险阻断等级；达到该等级及以上时阻止发布，常用值为 medium 或 high。
AGENT_BLOCK_LEVEL=high
# Agent 工具查询最多返回的记录数，避免一次返回过多数据。
AGENT_MAX_TOOL_ROWS=20
# Agent 单轮最多允许调用工具的次数，防止循环调用。
AGENT_MAX_TOOL_CALLS=5
# Agent 文本模型温度；值越低越稳定，越高越发散。
AGENT_CHAT_TEMPERATURE=0.2
# Agent 文本模型最大输出 token 数。
AGENT_CHAT_MAX_TOKENS=900
# 风险守卫模型温度；建议保持 0，保证判断稳定。
AGENT_GUARD_TEMPERATURE=0
# 风险守卫模型最大输出 token 数。
AGENT_GUARD_MAX_TOKENS=900
# 是否要求视觉检查；true 表示抽帧后用视觉模型判断画面风险。
AGENT_REQUIRE_VISION_CHECK=true
# 视觉检查失败时是否按阻断处理；true 表示模型不可用或检查失败时不允许继续发布。
AGENT_VISION_FAIL_CLOSED=true
# 每个视频最多抽取多少帧用于视觉检查。
AGENT_FRAME_MAX_COUNT=8
# 抽帧后缩放宽度；降低分辨率可减少视觉模型输入成本。
AGENT_FRAME_SCALE_WIDTH=640
# 视频开头第几秒开始抽第一帧，避免封面黑屏或片头无效画面。
AGENT_FRAME_FIRST_SECOND=1
# 距离视频结尾多少秒停止抽帧，避免尾帧黑屏或片尾无效画面。
AGENT_FRAME_END_OFFSET_SECONDS=2
# 视频中段抽帧比例；多个比例用英文逗号分隔，例如 0.25 表示视频 25% 位置。
AGENT_FRAME_SAMPLE_RATIOS=0.25,0.5,0.75
# 高风险关键词映射；格式为“关键词:风险分类”，多个规则用英文逗号分隔。
AGENT_HIGH_RISK_KEYWORDS=色情:色情低俗,裸露:色情低俗,自杀:自伤自杀,杀人:暴力犯罪,诈骗:诈骗导流,赌博:违法违规,毒品:违法违规,台独:政治敏感,港独:政治敏感,恐怖:恐怖极端
# 中风险关键词映射；命中后提示人工关注，是否阻断取决于 AGENT_BLOCK_LEVEL。
AGENT_MEDIUM_RISK_KEYWORDS=减肥:医疗健康宣称,治疗:医疗健康宣称,赚钱:营销/收益承诺,稳赚:金融风险,搬运:低质搬运风险
