# Vidferry 常用配置。复制为 .env 后修改，重启后端即可生效。
# 只需填写或修改你实际需要的项目；其余内部运行参数在 conf.py 的 INTERNAL_CONFIG 中维护。

# 文件路径
# 视频下载、处理后视频、转写文本的保存目录；可使用相对路径或绝对路径。
YOUTUBE_DOWNLOAD_DIR=./videos/youtube
YOUTUBE_PROCESSED_DIR=./videos/processed
YOUTUBE_TRANSCRIPT_DIR=./videos/transcripts

# YouTube JS challenge：首次部署请安装 Node.js 20+，默认会从 yt-dlp 官方 GitHub 仓库取得 EJS 组件。
# 如 node.exe 不在 PATH 中，再填写绝对路径；通常无需修改远程组件配置。
YTDLP_JS_RUNTIME=node
# YTDLP_JS_RUNTIME_PATH=C:/Program Files/nodejs/node.exe
YTDLP_REMOTE_COMPONENTS=ejs:github

# 文本模型（内容分析、字幕修订、发布文案、Agent）
# Provider 可选：zhipu、kimi、deepseek、volcengine_ark、dashscope、longcat、openai_compatible。
# 智谱示例：https://open.bigmodel.cn/api/paas/v4；Kimi 示例：https://api.moonshot.ai/v1；
# DeepSeek 示例：https://api.deepseek.com；火山方舟示例：https://ark.cn-beijing.volces.com/api/v3。
TEXT_LLM_PROVIDER=dashscope
TEXT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_LLM_API_KEY=sk-your-api-key
TEXT_LLM_MODEL=qwen-plus

# Feishu Agent Robot. Keep the real secret in the local .env only.
FEISHU_APP_ID=cli_example
FEISHU_APP_SECRET=replace-me
FEISHU_ALLOWED_OPEN_IDS=ou_example
FEISHU_BUTLER_CONSOLE_URL=http://127.0.0.1:55173

# 多模态模型（关键帧审核；必须支持 image_url 输入）
MULTIMODAL_LLM_PROVIDER=dashscope
MULTIMODAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MULTIMODAL_LLM_API_KEY=sk-your-api-key
MULTIMODAL_LLM_MODEL=qwen-vl-max

# 是否关闭推理模型的推理输出（thinking/reasoning），减少 token 消耗、避免超时与空 content。
# 默认开启。Provider 会按官方兼容接口发送关闭推理字段；模型不支持时自动移除字段继续调用，并在消息中心提示。
LLM_DISABLE_THINKING=true

# 中文字幕 LLM 修订
# 是否在 Google 初译后进行 LLM 修订；可填 true 或 false。
SUBTITLE_LLM_REVIEW_ENABLED=true
# 单个修订批次的最大字符数，范围 200-4000；调小更稳定，调大通常更省重复输入 token。
SUBTITLE_REVIEW_BATCH_MAX_CHARS=1200
# 同时发送的修订请求数，范围 1-16。
SUBTITLE_REVIEW_CONCURRENCY=4
# 单次修订的最大输出与推理 token，范围 512-8000。
SUBTITLE_REVIEW_MAX_TOKENS=8000

# Whisper 语音转写
# 可填 small、medium、large-v3 等 Whisper 模型名称；模型越大，转写质量和显存/耗时需求越高。
WHISPER_MODEL_SIZE=small
# 可填 cpu、cuda 或 auto。NVIDIA 显卡且 CUDA 可用时填写 cuda。
# 设为 cuda 时必须先安装 CUDA 运行库；不可用时字幕任务会被阻止并给出修复提示，不会自动回退 CPU。
WHISPER_DEVICE=cpu
# CPU 推荐 int8；CUDA 推荐 float16，显存不足时填写 int8_float16。
WHISPER_COMPUTE_TYPE=int8

# 视频渲染编码
# 可填 libx264（CPU，默认）或 h264_nvenc（NVIDIA GPU）。GPU 模式要求 FFmpeg 支持 h264_nvenc。
# h264_nvenc 必须由当前 FFmpeg 和 NVIDIA 驱动实际支持；不可用时渲染任务会被阻止，可改回 libx264。
VIDEO_ENCODER=libx264
# NVIDIA 编码预设：p1-p7；p1 最快，p7 画质最高，推荐 p5。仅 h264_nvenc 生效。
VIDEO_NVENC_PRESET=p5
# NVIDIA 恒定质量：0-51；数值越小画质越高、文件越大，推荐 23。仅 h264_nvenc 生效。
VIDEO_NVENC_CQ=23
# PostgreSQL is required. The deployment prompt fills these values locally.
DATABASE_URL=
POSTGRES_DB=vidferry
POSTGRES_USER=vidferry
POSTGRES_PASSWORD=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=8
DATABASE_POOL_TIMEOUT_SECONDS=30
# 应用认证。生产环境必须设置随机长密钥并启用 HTTPS Cookie。
VIDFERRY_AUTH_SECRET=
VIDFERRY_AUTH_COOKIE_SECURE=false
VIDFERRY_AUTH_IDLE_MINUTES=480
VIDFERRY_AUTH_ABSOLUTE_HOURS=24
VIDFERRY_AUTH_REMEMBER_HOURS=168
VIDFERRY_AUTH_MAX_FAILURES=5
VIDFERRY_AUTH_LOCK_MINUTES=15
VIDFERRY_AUTH_ALLOW_COOKIE_EXPORT=false
