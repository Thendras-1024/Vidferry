YOUTUBE_DOWNLOAD_DIR=./videos/youtube
YOUTUBE_PROCESSED_DIR=./videos/processed

# Local server binding and CORS. Keep HOST as 127.0.0.1 unless you really need LAN access.
VIDFERRY_HOST=127.0.0.1
VIDFERRY_PORT=5409
VIDFERRY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175

# SQLite and local workflow concurrency limits.
SQLITE_ENABLE_WAL=1
SQLITE_BUSY_TIMEOUT_MS=5000
WORKFLOW_MAX_DOWNLOAD_JOBS=2
WORKFLOW_MAX_PROCESSING_JOBS=1
WORKFLOW_MAX_ANALYSIS_JOBS=2

# Optional: yt-dlp JavaScript runtime. Leave empty to auto-detect deno first, then node.
# Example:
# YTDLP_JS_RUNTIME=node
# YTDLP_JS_RUNTIME_PATH=C:/nvm4w/nodejs/node.exe
# Optional: allow yt-dlp to fetch external challenge solver components when YouTube requires them.
# YTDLP_REMOTE_COMPONENTS=ejs:github

# Optional: OpenAI-compatible LLM endpoint for content analysis / editing plan.
# DashScope example:
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-your-dashscope-key
# LLM_MODEL=qwen-plus
# LLM_TIMEOUT=90
# LLM_MAX_TRANSCRIPT_CHARS=28000
