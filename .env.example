# Vidferry 部署配置。复制为 .env 后修改，重启后端即可生效。
# 仅填写与当前部署环境有关的项目；其余运行参数使用代码默认值。

# 文件路径
# 视频下载、处理后视频、转写文本的保存目录；可使用相对路径或绝对路径。
YOUTUBE_DOWNLOAD_DIR=./videos/youtube
YOUTUBE_PROCESSED_DIR=./videos/processed
YOUTUBE_TRANSCRIPT_DIR=./videos/transcripts

# YouTube 下载代理。留空时强制直连，避免继承系统中的 HTTP_PROXY/HTTPS_PROXY。
# YouTube 下载代理。留空时由 yt-dlp 自动读取系统代理；需要指定代理时再填写。
# YTDLP_PROXY=http://127.0.0.1:7890
YTDLP_PROXY=

# Hugging Face 模型下载代理。Whisper 首次下载模型时使用；可与 YTDLP_PROXY 相同。
# HF_PROXY=http://127.0.0.1:7890
HF_PROXY=

# 文本模型（内容分析、字幕修订、发布文案、Agent）
# 通用文本模型（内容分析、字幕修订、发布文案、Agent 文案与检索翻译）
# Provider 可选：zhipu、kimi、deepseek、volcengine_ark、dashscope、longcat、openai_compatible。
# 智谱示例：https://open.bigmodel.cn/api/paas/v4；Kimi 示例：https://api.moonshot.ai/v1；
# DeepSeek 示例：https://api.deepseek.com；火山方舟示例：https://ark.cn-beijing.volces.com/api/v3。
TEXT_LLM_PROVIDER=deepseek
TEXT_LLM_BASE_URL=https://api.deepseek.com
TEXT_LLM_API_KEY=sk-your-api-key
TEXT_LLM_MODEL=deepseek-v4-flash
# 通用文本调用关闭推理，降低字幕与文案生成的等待时间和成本。
LLM_DISABLE_THINKING=true

# 交互式 Agent（规划、工具决策与回复）默认复用 TEXT_LLM_*，但开启推理。
# 需要独立模型或密钥时，再填写 AGENT_LLM_PROVIDER、AGENT_LLM_BASE_URL、AGENT_LLM_API_KEY、AGENT_LLM_MODEL。
AGENT_LLM_ENABLE_THINKING=true
# Agent 上下文预算：DeepSeek Flash 为 1M 窗口；输出上限为应用级 64K 防护。
AGENT_OUTPUT_MAX_TOKENS=65536
AGENT_CONTEXT_MODEL_WINDOW_TOKENS=1000000
AGENT_CONTEXT_COMPACTION_TRIGGER_TOKENS=850000
AGENT_CONTEXT_COMPACTION_RECOVERY_TOKENS=650000
AGENT_CONTEXT_TOOL_RESULT_MAX_CHARS=16000
AGENT_CONTEXT_TOOL_TOTAL_MAX_CHARS=64000

# Feishu Agent Robot. Keep the real secret in the local .env only.
FEISHU_APP_ID=cli_example
FEISHU_APP_SECRET=replace-me
FEISHU_ALLOWED_OPEN_IDS=ou_example
FEISHU_AGENT_OWNER_USER_ID=0

# 快手开放平台（可选）。作品分析会优先使用已授权的 user_video_info；未授权时使用可见创作者中心。
# 账号 access token 保存在该账号所有者 cookiesFile 目录的 sidecar 中，不写入 .env、日志或 Agent 上下文。
KUAISHOU_OPEN_APP_ID=
KUAISHOU_OPEN_APP_SECRET=

# 多模态模型（关键帧审核；必须支持 image_url 输入）
MULTIMODAL_LLM_PROVIDER=dashscope
MULTIMODAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MULTIMODAL_LLM_API_KEY=sk-your-api-key
MULTIMODAL_LLM_MODEL=qwen-vl-max

# Whisper 语音转写（当前使用）
# 可填 small、medium、large-v3 等 Whisper 模型名称；模型越大，转写质量和显存/耗时需求越高。
WHISPER_MODEL_SIZE=small
# 可填 cpu、cuda 或 auto。NVIDIA 显卡且 CUDA 可用时填写 cuda。
# 设为 cuda 时必须先安装 CUDA 运行库；不可用时字幕任务会被阻止并给出修复提示，不会自动回退 CPU。
WHISPER_DEVICE=cpu
# CPU 推荐 int8；CUDA 推荐 float16，显存不足时填写 int8_float16。
WHISPER_COMPUTE_TYPE=int8

# 视频渲染编码
# 可填 libx264（CPU，默认）或 h264_nvenc（NVIDIA GPU）。GPU 模式要求 FFmpeg 支持 h264_nvenc。
# h264_nvenc 必须由当前 FFmpeg 和 NVIDIA 驱动实际支持；不可用时渲染任务会被阻止，可改回 libx264。
VIDEO_ENCODER=libx264
# PostgreSQL is required. The deployment prompt fills these values locally.
DATABASE_URL=
POSTGRES_DB=vidferry
POSTGRES_USER=vidferry
POSTGRES_PASSWORD=
# 应用认证。生产环境必须设置随机长密钥并启用 HTTPS Cookie。
VIDFERRY_AUTH_SECRET=
VIDFERRY_AUTH_COOKIE_SECURE=false
VIDFERRY_AUTH_ALLOW_COOKIE_EXPORT=false
# 公网部署时填写反向代理的完整来源，例如 https://vidferry.example.com，不要使用通配符。
VIDFERRY_CORS_ORIGINS=http://127.0.0.1:55173,http://localhost:55173
# 单用户累计素材空间上限（MB）。
VIDFERRY_USER_STORAGE_QUOTA_MB=20480
VIDFERRY_USER_UPLOAD_MAX_MB=160
VIDFERRY_USER_UPLOADS_PER_MINUTE=10
VIDFERRY_USER_TASK_SUBMISSIONS_PER_MINUTE=30
# 所有有效发布目标均为 confirmed 或 reused 的视频，最后一次成功发布满此天数后清理本地媒体文件。
VIDEO_LOCAL_RETENTION_SUCCESS_DAYS=3
# 部分成功（至少一个成功，其余为 failed / timeout / cancelled）的线索，最后一次成功发布满此天数后清理。
VIDEO_LOCAL_RETENTION_DAYS=7
# 清理器启动后会立即扫描，之后每隔此小时数扫描一次。
VIDEO_LOCAL_CLEANUP_INTERVAL_HOURS=24
# 每轮扫描最多清理的线索数，避免单轮占用过多磁盘和 I/O 资源。
VIDEO_LOCAL_CLEANUP_BATCH_SIZE=50
# 可选值：off = 不扫描；report = 仅记录候选，不删除文件；delete = 删除符合条件的本地媒体并移入历史线索。
VIDEO_LOCAL_CLEANUP_MODE=delete

# 手机号登录默认关闭。启用前需完成腾讯云国内短信签名、模板和验证码审核；所有密钥只保存在本机 .env。
VIDFERRY_AUTH_PHONE_LOGIN_ENABLED=false
# 首次完成手机号验证后自动创建普通用户。生产环境完成安全检查后再开启。
VIDFERRY_AUTH_PHONE_AUTO_REGISTER_ENABLED=false
VIDFERRY_AUTH_PHONE_HMAC_SECRET=
VIDFERRY_AUTH_RATE_LIMIT_HMAC_SECRET=
VIDFERRY_AUTH_TENCENT_SECRET_ID=
VIDFERRY_AUTH_TENCENT_SECRET_KEY=
VIDFERRY_AUTH_TENCENT_SMS_APP_ID=
VIDFERRY_AUTH_TENCENT_SMS_SIGN=
VIDFERRY_AUTH_TENCENT_SMS_TEMPLATE_ID=
VIDFERRY_AUTH_TENCENT_CAPTCHA_APP_ID=
VIDFERRY_AUTH_TENCENT_CAPTCHA_APP_SECRET_KEY=
# 仅在反向代理连接源位于这些 CIDR 时读取 X-Forwarded-For；留空时始终使用连接源 IP。
VIDFERRY_AUTH_TRUSTED_PROXY_CIDRS=
